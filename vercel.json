{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{index.php,rsvp.php,style.css,app.js,Wedding-List-Complete.xlsx}"
    }
  },
  "rewrites": [
    { "source": "/rsvp.php", "destination": "/api/rsvp.php" },
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.php", "destination": "/api/index.php" }
  ]
}
