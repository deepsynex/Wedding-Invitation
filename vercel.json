{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{index.php,rsvp.php,style.css,app.js,Wedding-List-Complete.xlsx}"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index\.php", "dest": "/api/index.php" },
    { "src": "/rsvp\.php", "dest": "/api/rsvp.php" },
    { "src": "/(.*\.(xlsx|lock|md))", "status": 404 }
  ]
}
